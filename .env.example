# Set automatically when the Neon database is connected (Vercel → Storage → Neon)
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Starting admin password (can be changed later from the dashboard → Settings)
ADMIN_PASSWORD=change-me

# Long random string used to sign admin sessions — e.g. openssl rand -hex 32
SESSION_SECRET=
